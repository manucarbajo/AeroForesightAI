      "source": "trajectory",
      "min_value": -0.05,
      "max_value": 0.1,
      "trajectory": {
        "baseline": 0.03,
        "rules": []
      }
    },
    {
      "id": "fuel_price_change",
      "type": "numeric",
      "unit": "fraction_per_tick",
      "description": "Veraenderung der Treibstoffkosten pro Tick",
      "source": "trajectory",
      "min_value": -0.1,
      "max_value": 0.2,
      "trajectory": {
        "baseline": 0.005,
        "rules": []
      }
    },
    {
      "id": "carbon_tax_level",
      "type": "numeric",
      "unit": "eur_per_tonne",
      "description": "CO2-Bepreisung pro Tonne in EUR",
      "source": "trajectory",
      "min_value": 0.0,
      "max_value": 300.0,
      "trajectory": {
        "baseline": 50.0,
        "rules": [
          {
            "active_from_tick": 1,
            "effect": {
              "type": "set",
              "value": 50.0
            }
          },
          {
            "active_from_tick": 15,
            "effect": {
              "type": "set",
              "value": 120.0
            }
          },
          {
            "active_from_tick": 30,
            "effect": {
              "type": "set",
              "value": 200.0
            }
          }
        ]
      }
    },
    {
      "id": "oil_price_index",
      "type": "numeric",
      "unit": "index",
      "description": "Relativer Index fuer Rohoel (1.0 = Basisjahr)",
      "source": "trajectory",
      "min_value": 0.5,
      "max_value": 3.0,
      "trajectory": {
        "baseline": 1.0,
        "rules": []
      }
    },
    {
      "id": "saf_mandate_share",
      "type": "numeric",
      "unit": "fraction",
      "description": "Gesetzlich vorgeschriebener Anteil nachhaltiger Treibstoffe",
      "source": "trajectory",
      "min_value": 0.0,
      "max_value": 0.5,
      "trajectory": {
        "baseline": 0.0,
        "rules": [
          {
            "active_from_tick": 8,
            "effect": {
              "type": "set",
              "value": 0.02
            }
          },
          {
            "active_from_tick": 16,
            "effect": {
              "type": "set",
              "value": 0.05
            }
          }
        ]
      }
    },
    {
      "id": "efuel_subsidy",
      "type": "numeric",
      "unit": "fraction",
      "description": "Subventionsrate fuer E-Fuel (0-1)",
      "source": "trajectory",
      "min_value": 0.0,
      "max_value": 1.0,
      "trajectory": {
        "baseline": 0.0,
        "rules": []
      }
    },
    {
      "id": "provider_markup",
      "type": "numeric",
      "unit": "eur",
      "description": "Runtime-Anbieter-Marge; emergent via market_rules",
      "source": "runtime",
      "min_value": 0.0,
      "trajectory": {
        "baseline": 28.0,
        "rules": []
      }
    },
    {
      "id": "ticket_price",
      "type": "numeric",
      "unit": "eur",
      "description": "Veroeffentlichter Ticketpreis (cost_pressure + provider_markup)",
      "source": "computed",
      "min_value": 1.0,
      "trajectory": {
        "baseline": 128.0,
        "rules": []
      }
    },
    {
      "id": "income_index",
      "type": "numeric",
      "unit": "index",
      "description": "Makroökonomischer Einkommensindex (1.0 = Basisniveau). Skaliert WTP aller Individuen.",
      "source": "trajectory",
      "min_value": 0.5,
      "max_value": 1.5,
      "trajectory": {
        "baseline": 1.0,
        "rules": [
          {
            "active_from_tick": 10,
            "effect": {
              "type": "ramp",
              "value": 0.92,
              "duration_ticks": 5
            }
          },
          {
            "active_from_tick": 20,
            "effect": {
              "type": "set",
              "value": 1.05
            }
          }
        ]
      }
    },
    {
      "id": "bevoelkerungsentwicklung",
      "type": "numeric",
      "unit": "persons",
      "source": "trajectory",
      "trajectory": {
        "type": "step_function",
        "points": [
          {
            "tick": 1,
            "value": 1000
          },
          {
            "tick": 10,
            "value": 1020
          },
          {
            "tick": 20,
            "value": 1050
          },
          {
            "tick": 30,
            "value": 1080
          }
        ]
      }
    },
    {
      "id": "maintenance_cost_index",
      "type": "numeric",
      "unit": "index",
      "description": "Index for maintenance costs",
      "source": "trajectory",
      "min_value": 0.5,
      "max_value": 2.0,
      "trajectory": {
        "baseline": 1.0,
        "rules": []
      }
    },
    {
      "id": "staff_cost_index",
      "type": "numeric",
      "unit": "index",
      "description": "Index for staff costs",
      "source": "trajectory",
      "min_value": 0.5,
      "max_value": 2.0,
      "trajectory": {
        "baseline": 1.0,
        "rules": []
      }
    },
    {
      "id": "airport_fee",
      "type": "numeric",
      "unit": "EUR",
      "description": "Airport Fee",
      "source": "trajectory",
      "price_component_type": "fee",
      "trajectory": {
        "baseline": 0.0,
        "rules": []
      }
    }
  ],
  "individual_properties": [
    {
      "id": "business",
      "type": "boolean",
      "enabled": true,
      "prevalence": 0.3
    },
    {
      "id": "price_sensitive",
      "type": "boolean",
      "enabled": true,
      "prevalence": 0.45
    },
    {
      "id": "eco_conscious",
      "type": "boolean",
      "enabled": true,
      "prevalence": 0.2
    },
    {
      "id": "environmental_awareness",
      "type": "distribution",
      "enabled": true,
      "distribution": "beta",
      "min_value": 0.0,
      "max_value": 1.0,
      "alpha": 2.0,
      "beta": 5.0
    },
    {
      "id": "wtp_eur",
      "type": "distribution",
      "enabled": true,
      "distribution": "lognormal",
      "mean": 120.0,
      "std_dev": 0.35,
      "min_value": 50.0,
      "max_value": 500.0
    },
    {
      "id": "age",
      "type": "distribution",
      "enabled": true,
      "distribution": "lognormal",
      "mean": 73.0,
      "std_dev": 1.0,
      "min_value": 2.0,
      "max_value": 90.0
    },
    {
      "id": "substitution_readiness",
      "type": "distribution",
      "enabled": true,
      "distribution": "beta",
      "min_value": 0.0,
      "max_value": 1.0,
      "alpha": 2.0,
      "beta": 5.0
    },
    {
      "id": "frequent_flyer",
      "type": "boolean",
      "enabled": true,
      "prevalence": 0.05
    }
  ],
  "shift_rules": [
