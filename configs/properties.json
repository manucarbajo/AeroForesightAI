  ],
  "factor_rules": [
    {
      "id": "f1_low_booking_substitution",
      "factor_id": "F1",
      "when": {
        "metric": "booking_rate",
        "below": 0.45
      },
      "effect": {
        "set_state": "F1.2"
      },
      "priority": 10
    },
    {
      "id": "f1_strong_demand",
      "factor_id": "F1",
      "when": {
        "metric": "booking_rate",
        "above": 0.68
      },
      "effect": {
        "set_state": "F1.1"
      },
      "priority": 5
    },
    {
      "id": "f2_high_carbon_policy",
      "factor_id": "F2",
      "when": {
        "system_property": "carbon_tax_level",
        "above": 100
      },
      "effect": {
        "set_state": "F2.2"
      },
      "priority": 10
    },
    {
      "id": "f2_moderate_policy",
      "factor_id": "F2",
      "when": {
        "system_property": "carbon_tax_level",
        "below": 80
      },
      "effect": {
        "set_state": "F2.1"
      },
      "priority": 4
    },
    {
      "id": "f3_saf_mandate_breakthrough",
      "factor_id": "F3",
      "when": {
        "system_property": "saf_mandate_share",
        "at_least": 0.05
      },
      "effect": {
        "set_state": "F3.2"
      },
      "priority": 10
    },
    {
      "id": "f3_incremental_tech",
      "factor_id": "F3",
      "when": {
        "system_property": "saf_mandate_share",
        "below": 0.03
      },
      "effect": {
        "set_state": "F3.1"
      },
      "priority": 3
    },
    {
      "id": "f4_high_cost_pressure",
      "factor_id": "F4",
      "when": {
        "metric": "cost_pressure",
        "above": 135
      },
      "effect": {
        "set_state": "F4.2"
      },
      "priority": 8
    },
    {
      "id": "f4_stable_growth",
      "factor_id": "F4",
      "when": {
        "metric": "cost_pressure",
        "below": 115
      },
      "effect": {
        "set_state": "F4.1"
      },
      "priority": 4
    },
    {
      "id": "f5_alternatives_flight_shaming",
      "factor_id": "F5",
      "when": {
        "factor": "F6",
        "state": "F6.2"
      },
      "effect": {
        "set_state": "F5.2"
      },
      "priority": 8
    },
    {
      "id": "f5_no_alternative",
      "factor_id": "F5",
      "when": {
        "factor": "F6",
        "state": "F6.1"
      },
      "effect": {
        "set_state": "F5.1"
      },
      "priority": 4
    },
    {
      "id": "f6_flight_shaming_high_tax",
      "factor_id": "F6",
      "when": {
        "system_property": "carbon_tax_level",
        "above": 80
      },
      "effect": {
        "set_state": "F6.2"
      },
      "priority": 10
    },
    {
      "id": "f6_accepted_flying",
      "factor_id": "F6",
      "when": {
        "system_property": "carbon_tax_level",
        "below": 60
      },
      "effect": {
        "set_state": "F6.1"
      },
      "priority": 4
    },
    {
      "id": "f7_oil_stress",
      "factor_id": "F7",
      "when": {
        "system_property": "oil_price_index",
        "above": 1.15
      },
      "effect": {
        "set_state": "F7.2"
      },
      "priority": 6
    },
    {
      "id": "f7_open_markets",
      "factor_id": "F7",
      "when": {
        "system_property": "oil_price_index",
        "below": 1.1
      },
      "effect": {
        "set_state": "F7.1"
      },
      "priority": 3
    }
  ],
  "market_rules": [
    {
      "id": "provider_yield_feedback",
      "when": {
        "enabled": true
      },
      "effect": {
        "type": "booking_yield_feedback",
        "update_property": "provider_markup",
        "publish_property": "ticket_price",
        "compose": "cost_pressure + provider_markup",
        "target_booking_rate": 0.7,
        "markup_adjustment_per_tick": 0.08,
        "max_price_change_fraction": 0.08,
        "damping": 0.85,
        "booking_weight": 0.6
      }
    }
  ],
  "price_model": {
    "base_price": 100.0,
    "compound_fuel_on_cost": true,
    "cost_properties": [
      "fuel_price_change",
      "carbon_tax_level",
      "oil_price_index",
      "saf_mandate_share",
      "efuel_subsidy",
      "maintenance_cost_index",
      "staff_cost_index"
    ],
    "coefficients": {
      "carbon_per_tonne": 0.001,
      "saf_premium_factor": 0.5,
      "min_ticket_price": 1.0,
      "margin_reference_fraction": 0.08,
      "margin_floor_fraction": 0.05,
      "target_booking_tolerance": 0.9
    }
  },
  "market_feedback": {
    "enabled": true,
    "target_booking_rate": 0.7,
    "markup_adjustment_per_tick": 0.08,
    "max_price_change_fraction": 0.08,
    "damping": 0.85,
    "booking_weight": 0.6
  },
  "regulatory_influences": [
    {
      "id": "eu_ets",
      "description": "EU Emissionshandel",
      "cost_contribution": 5.0,
      "when": {
        "factor": "F2",
        "state": "F2.2"
      }
    },
    {
      "id": "refueleu",
      "description": "SAF-Beimischungspflicht RefuelEU",
      "cost_contribution": 10.0,
      "when": {
        "factor": "F6",
        "state": "F6.2"
      }
    },
    {
      "id": "corsia",
      "description": "ICAO CORSIA Offsets",
      "cost_contribution": 2.0,
      "when": {
        "factor": "F4",
        "state": "F4.2"
      }
    },
    {
      "id": "national_aviation_tax",
      "description": "Nationale Luftverkehrssteuer",
      "cost_contribution": 8.0,
      "when": {
        "factor": "F2",
        "state": "F2.1"
