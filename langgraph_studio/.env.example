LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=<dein-key>

# Das Sprachmodell. Ohne eine dieser Angaben scheitert `get_llm()` seit P3.4
# ausdruecklich, statt still den Mock zu waehlen -- ein Lauf mit erfundenen
# Agenten-Antworten soll nicht wie ein vollwertiger aussehen.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_MAX_TOKENS=2048

# Ausdruecklich mit erfundenen Antworten rechnen (Studio, Szenario-CLI). Auf der
# Batch-CLI heisst derselbe Wunsch `--mock-llm`, im Dashboard «Ohne Sprachmodell».
# AEROFORESIGHT_MOCK_LLM=1
